{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeology.dev/schemas/v1/rubric.schema.json",
  "title": "Codeology public assessment rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rubricId", "rubricVersion", "scenarioRef", "title", "status", "levels", "criteria", "source"],
  "properties": {
    "schemaVersion": {"const": 1},
    "rubricId": {"$ref": "common.schema.json#/$defs/stableId"},
    "rubricVersion": {"$ref": "common.schema.json#/$defs/version"},
    "scenarioRef": {"$ref": "common.schema.json#/$defs/scenarioRef"},
    "title": {"type": "string", "minLength": 3},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "anchor"],
        "properties": {
          "id": {"type": "string", "enum": ["insufficient", "developing", "competent", "strong"]},
          "anchor": {"type": "string", "minLength": 15}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterionId", "title", "kind", "description", "observableEvidence", "skillRefs"],
        "properties": {
          "criterionId": {"$ref": "common.schema.json#/$defs/stableId"},
          "title": {"type": "string", "minLength": 3},
          "kind": {"type": "string", "enum": ["hard-reject", "quality"]},
          "description": {"type": "string", "minLength": 15},
          "observableEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 8}
          },
          "hardRejectCondition": {"type": "string", "minLength": 10},
          "skillRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/skillRef"}
          }
        }
      }
    },
    "source": {"$ref": "common.schema.json#/$defs/source"}
  }
}
