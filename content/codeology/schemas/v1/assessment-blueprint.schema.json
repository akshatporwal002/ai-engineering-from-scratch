{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeology.dev/schemas/v1/assessment-blueprint.schema.json",
  "title": "Codeology pilot assessment coverage blueprint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "blueprintId", "blueprintVersion", "status", "title", "pathwayRef", "jobTaskAnalysisRef", "mappings", "reviewers", "limitations", "source"],
  "properties": {
    "schemaVersion": {"const": 1},
    "blueprintId": {"$ref": "common.schema.json#/$defs/stableId"},
    "blueprintVersion": {"$ref": "common.schema.json#/$defs/version"},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "title": {"type": "string", "minLength": 5},
    "pathwayRef": {"$ref": "common.schema.json#/$defs/pathwayRef"},
    "jobTaskAnalysisRef": {"$ref": "common.schema.json#/$defs/jobTaskAnalysisRef"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mappingId", "taskId", "scenarioRef", "rubricRef", "criterionIds", "skillRefs", "evidenceRole"],
        "properties": {
          "mappingId": {"$ref": "common.schema.json#/$defs/stableId"},
          "taskId": {"$ref": "common.schema.json#/$defs/stableId"},
          "scenarioRef": {"$ref": "common.schema.json#/$defs/scenarioRef"},
          "rubricRef": {"$ref": "common.schema.json#/$defs/rubricRef"},
          "criterionIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/stableId"}
          },
          "skillRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/skillRef"}
          },
          "evidenceRole": {"type": "string", "enum": ["primary", "supporting"]}
        }
      }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewerId", "perspective", "decision", "reviewedMappingIds", "notes"],
        "properties": {
          "reviewerId": {"$ref": "common.schema.json#/$defs/stableId"},
          "perspective": {"type": "string", "enum": ["software-engineer", "hiring-manager", "assessment-specialist"]},
          "decision": {"type": "string", "enum": ["approve", "revise", "reject"]},
          "reviewedMappingIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "common.schema.json#/$defs/stableId"}
          },
          "notes": {"type": "string", "minLength": 15}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 15}
    },
    "source": {"$ref": "common.schema.json#/$defs/source"}
  }
}
