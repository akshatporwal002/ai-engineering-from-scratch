{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeology.dev/schemas/v1/pathway.schema.json",
  "title": "Codeology pathway and skill graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pathwayId", "pathwayVersion", "title", "summary", "status", "targetRole", "skillRefs", "prerequisiteEdges", "scenarioRefs", "source"],
  "properties": {
    "schemaVersion": {"const": 1},
    "pathwayId": {"$ref": "common.schema.json#/$defs/stableId"},
    "pathwayVersion": {"$ref": "common.schema.json#/$defs/version"},
    "title": {"type": "string", "minLength": 3},
    "summary": {"type": "string", "minLength": 20},
    "status": {"$ref": "common.schema.json#/$defs/status"},
    "targetRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "jobTaskAnalysisRef"],
      "properties": {
        "title": {"type": "string", "minLength": 3},
        "jobTaskAnalysisRef": {"$ref": "common.schema.json#/$defs/jobTaskAnalysisRef"}
      }
    },
    "assessmentBlueprintRef": {"$ref": "common.schema.json#/$defs/assessmentBlueprintRef"},
    "skillRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/skillRef"}
    },
    "prerequisiteEdges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromSkillId", "toSkillId", "kind"],
        "properties": {
          "fromSkillId": {"$ref": "common.schema.json#/$defs/stableId"},
          "toSkillId": {"$ref": "common.schema.json#/$defs/stableId"},
          "kind": {"const": "prerequisite"}
        }
      }
    },
    "scenarioRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/scenarioRef"}
    },
    "source": {"$ref": "common.schema.json#/$defs/source"}
  }
}
